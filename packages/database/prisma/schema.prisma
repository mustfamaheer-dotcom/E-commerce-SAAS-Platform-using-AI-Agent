// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique @db.VarChar(63)
  name            String   @db.VarChar(255)
  currency        String   @default("EGP") @db.VarChar(3)
  theme           Json     @default("{\"mode\":\"light\",\"primaryColor\":\"#4F46E5\",\"backgroundColor\":\"#F8FAFC\"}")
  paymentMethods  String[] @default([]) @map("payment_methods")
  shippingPolicy  String?  @map("shipping_policy") @db.Text
  logoUrl         String?  @map("logo_url") @db.VarChar(512)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users           User[]
  categories      Category[]
  products        Product[]
  inventory       Inventory[]
  orders          Order[]
  customers       Customer[]
  promotions      Promotion[]
  policies        Policy[]
  agentActions    AgentAction[]
  merchantMemories MerchantMemory[]
  chatSessions    ChatSession[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role         String   @default("customer") @db.VarChar(20) // merchant | customer | admin
  displayName  String?  @map("display_name") @db.VarChar(100)
  clerkUserId  String?  @unique @map("clerk_user_id") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(255)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  categoryId  String?     @map("category_id") @db.Uuid
  sku         String      @db.VarChar(100)
  name        String      @db.VarChar(255)
  description String?     @db.Text
  price       Decimal     @db.Decimal(12, 2)
  cost        Decimal     @default(0.00) @db.Decimal(12, 2)
  metadata    Json?       @default("{}")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory   Inventory?
  orderItems  OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId, isActive])
  @@map("products")
}

model Inventory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @unique @map("product_id") @db.Uuid
  quantity     Int      @default(0)
  reorderLevel Int      @default(10) @map("reorder_level")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inventory")
}

// Renad Slice 05: Customer demographic & RFM segmentation data
model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  city       String   @default("Cairo") @db.VarChar(100)
  rfmSegment String?  @map("rfm_segment") @db.VarChar(50) // VIP Champions, Loyal, New, At-Risk of Churn, Hibernating / Lost
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([tenantId, email])
  @@index([tenantId, rfmSegment])
  @@map("customers")
}

// Renad Slice 05: Multi-order RFM tracking with payment and shipping references
model Order {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  customerId  String?     @map("customer_id") @db.Uuid
  status      String      @default("pending") @db.VarChar(50) // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED
  total       Decimal     @db.Decimal(12, 2)
  currency    String      @default("EGP") @db.VarChar(3)
  paymentRef  String?     @map("payment_ref") @db.VarChar(255)
  shippingAwB String?     @map("shipping_awb") @db.VarChar(255)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])
  customer    Customer?   @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  payments    Payment[]

  @@index([tenantId, customerId, status, createdAt(sort: Desc)], name: "idx_orders_rfm_lookup")
  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal  @default(0.0) @db.Decimal(5, 4)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  provider  String   @db.VarChar(50) // paymob | fawry | instapay
  status    String   @default("pending") @db.VarChar(50)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Promotion {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String    @db.VarChar(50)
  name          String    @default("Promo") @db.VarChar(255)
  discountPct   Decimal   @map("discount_pct") @db.Decimal(5, 2)
  targetSegment String?   @map("target_segment") @db.VarChar(50)
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime  @map("ends_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, targetSegment])
  @@map("promotions")
}

model Policy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String   @db.VarChar(255)
  content   String   @db.Text
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("policies")
}

// Roaa Slice 06: Immutable audit logger for all agent tool executions
model AgentAction {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  toolName     String   @map("tool_name") @db.VarChar(100)
  params       Json     @default("{}")
  status       String   @default("PENDING_CONFIRMATION") @db.VarChar(50) // PENDING_CONFIRMATION | EXECUTED | REJECTED | FAILED
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, toolName, status])
  @@map("agent_actions")
}

// Roaa Slice 06: Persistent 3-Tier long-term merchant preferences
model MerchantMemory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  memoryKey   String   @map("memory_key") @db.VarChar(100)
  memoryValue String   @map("memory_value") @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memoryKey])
  @@index([tenantId])
  @@map("merchant_memories")
}

// Roaa Slice 06: Short-term chat session window & message history
model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  title     String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at")
  messages  ChatMessage[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("chat_sessions")
}

model ChatMessage {
  id           String      @id @default(uuid()) @db.Uuid
  sessionId    String      @map("session_id") @db.Uuid
  role         String      @db.VarChar(20) // user | assistant | system
  content      String      @db.Text
  genUiPayload Json?       @map("gen_ui_payload")
  createdAt    DateTime    @default(now()) @map("created_at")
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// Retaj Slice 04: Holiday/season calendar used by time-series forecasting
model CalendarEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventName String   @map("event_name") @db.VarChar(100)
  eventType String   @map("event_type") @db.VarChar(50)
  country   String   @default("EG") @db.Char(2)
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  weight    Decimal  @default(1.00) @db.Decimal(3, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([country, startsOn, endsOn])
  @@map("calendar_events")
}
