# ==============================================================================
# TechZone Agentic E-Commerce SaaS Platform - Environment Configuration Template
# ==============================================================================

# --- Application Server & Host ---
ENV=development                  # development | staging | production
HOST=0.0.0.0
PORT=8001                        # FastAPI primary backend port
FRONTEND_PORT=5173               # React Vite development server port
DEBUG=false

# --- PostgreSQL Primary Database ---
# Replace localhost with 'postgres' when running inside Docker Compose
POSTGRES_USER=techzone
POSTGRES_PASSWORD=techzone_secret_change_in_prod
POSTGRES_DB=techzone_db
DATABASE_URL=postgresql://techzone:techzone_secret_change_in_prod@localhost:5432/techzone_db

# --- Redis Caching, Rate Limiting & Message Broker ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication & Security Secrets ---
# MUST be a cryptographically secure random string with minimum 32 bytes in staging/production
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_bytes_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days (60 * 24 * 7)

# --- AI & Large Language Model (LLM) Providers ---
LLM_PROVIDER=gemini              # gemini | groq | openai | local
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:3b

# --- Observability, APM & LLM Tracing ---
LANGFUSE_PUBLIC_KEY=pk-demo-techzone
LANGFUSE_SECRET_KEY=sk-demo-techzone
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_SALT=techzone_salt_12345
LANGFUSE_SECRET=super_secret_langfuse_techzone_token

# --- Search Engine (MeiliSearch) ---
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKeyTechZone123_change_in_prod

# --- MLOps & Sales Forecasting Microservice ---
ML_SERVICE_URL=http://localhost:8100
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://techzone-mlflow-artifacts/
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret

# --- Payment Gateways & Logistics Integrations (Egypt) ---
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co

# --- Frontend Client Environment Variables ---
VITE_API_BASE_URL=/api/v1
